# Copy this file to ".env" and fill in real values.
# Only variables prefixed with VITE_ are exposed to the browser.

# Base URL of your backend API in production (leave unset in dev — Vite proxies /api).
VITE_API_URL=

# Google OAuth 2.0 Web client ID (same value as the backend's GOOGLE_CLIENT_ID).
# From Google Cloud Console > APIs & Services > Credentials.
# Leave blank to hide the Google button (email/password login still works).
VITE_GOOGLE_CLIENT_ID=
