# Copy to ".env" and fill in.

# --- Database -------------------------------------------------------------
# SQLite (default, zero setup). The file is created by `npm run prisma:migrate`.
DATABASE_URL="file:./dev.db"
# To switch to PostgreSQL later:
#   1. In prisma/schema.prisma change: provider = "postgresql"
#   2. DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/fyp?schema=public"
#   3. npm run prisma:migrate

# --- Auth --------------------------------------------------------------------
# Any long random string. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="change-me-to-a-long-random-string"
JWT_EXPIRES_IN="7d"

# --- Google Sign-In --------------------------------------------------------
# From Google Cloud Console > APIs & Services > Credentials > OAuth 2.0 Client ID
# (type: Web application). Only the Client ID is needed for ID-token verification.
# Leave blank to disable Google login (email/password still works).
GOOGLE_CLIENT_ID=""

# --- Server --------------------------------------------------------------
PORT=4000
# Origin of the frontend, for CORS.
CLIENT_URL="http://localhost:5173"
