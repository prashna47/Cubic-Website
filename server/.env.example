# Copy to ".env" and fill in.

# --- Database (Railway Postgres) -----------------------------------------
# Railway > your Postgres service > "Connect" tab > "Postgres Connection URL".
# Use the PUBLIC URL for local dev; on Railway itself the private URL is injected.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/railway"

# --- Clerk --------------------------------------------------------------
# Clerk Dashboard > API keys.
CLERK_PUBLISHABLE_KEY="pk_test_..."
CLERK_SECRET_KEY="sk_test_..."
# Clerk Dashboard > Webhooks > add endpoint {API_URL}/api/webhooks/clerk,
# subscribe to user.* events, then paste its Signing Secret here.
CLERK_WEBHOOK_SIGNING_SECRET="whsec_..."

# --- Server -----------------------------------------------------------------
PORT=4000
# Origin of the frontend, for CORS.
CLIENT_URL="http://localhost:5173"
