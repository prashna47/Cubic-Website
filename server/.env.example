# Copy to ".env" and fill in.

# --- Database (Neon Postgres — free) -----------------------------------
# Neon dashboard > your project > "Connect" > framework "Prisma".
# It shows exactly these two lines:
#   DATABASE_URL = the POOLED url  (host contains "-pooler")
#   DIRECT_URL   = the DIRECT url  (same host without "-pooler")
# If your provider has no separate pooled url, set both to the same value.
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require"
DIRECT_URL="postgresql://USER:PASSWORD@ep-xxx.REGION.aws.neon.tech/neondb?sslmode=require"

# --- Clerk --------------------------------------------------------------
# Clerk Dashboard > API keys.
CLERK_PUBLISHABLE_KEY="pk_test_..."
CLERK_SECRET_KEY="sk_test_..."
# Clerk Dashboard > Webhooks > add endpoint {API_URL}/api/webhooks/clerk,
# subscribe to user.* events, then paste its Signing Secret here.
CLERK_WEBHOOK_SIGNING_SECRET="whsec_..."

# --- Server -----------------------------------------------------------------
PORT=4000
# Origin of the frontend, for CORS.
CLIENT_URL="http://localhost:5173"
