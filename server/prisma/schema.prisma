// https://www.prisma.io/docs

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  // Pooled connection for the app; direct connection for migrations.
  // Neon's dashboard gives you both (Connect > "Prisma" shows these two lines).
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// Local mirror of the Clerk user. Clerk owns identity (email, password, OAuth,
// MFA); this row exists so app data can have a foreign key to a user, and is
// created/updated from Clerk (lazily on first authenticated request, and via
// the Clerk webhook — see server/README.md).
model User {
  id        String   @id @default(cuid())
  clerkId   String   @unique
  email     String   @unique
  name      String?
  avatarUrl String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
